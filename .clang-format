# Style for HigFlow sources, derived from the code already in the tree.
#
# This file describes the existing convention so new code matches it. It is
# NOT an instruction to reformat the repository: running clang-format over
# 176,000 lines would rewrite every line's blame and make the next merge with
# any of the unmerged upstream branches unresolvable.
#
# Format only what you touch:
#     git clang-format
#
# higtree/ carries its own .clang-format, because it is tab-indented while
# higflow/ is space-indented. Both were measured, not assumed.

Language: Cpp
BasedOnStyle: LLVM

# Measured: higflow/src is 98% space-indented, four columns.
IndentWidth: 4
UseTab: Never
TabWidth: 4

# Measured: 944 function definitions open the brace on the same line
# against 440 on the next.
BreakBeforeBraces: Attached

# Measured: 4047 occurrences of `type *name` against 108 of `type* name`.
PointerAlignment: Right
DerivePointerAlignment: false

# No column limit. Line length is already sane - median 39, 90th percentile
# 79 - and setting a limit would let clang-format rewrap untouched lines,
# turning a one-line change into a paragraph-sized diff.
ColumnLimit: 0

AlignAfterOpenBracket: Align
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false
IndentCaseLabels: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 2
SpaceAfterCStyleCast: false
SpaceBeforeParens: ControlStatements
SortIncludes: false
