# Everything excluded here stays out of the build context, so it never reaches
# the daemon and never ends up in a layer. On this repository that matters: the
# context would otherwise carry ~78 MB of archives and compiled binaries that
# the image has no use for.
#
# This file lives at the repository root, not next to the Dockerfile. The build
# context is the root (`docker build -f containers/Dockerfile .`), and both the
# classic builder and BuildKit look for `<context>/.dockerignore`. A copy under
# containers/ would be read by neither.

.git
.github
.gitignore
.gitattributes
.mailmap

# Third-party archives. PETSc is downloaded inside the build, with its checksum
# verified; the tarball in the context would only bloat it.
bibliotecas/petsc-*.tar.gz
bibliotecas/petsc-*/
bibliotecas/libfyaml-master/

# Compiled output. Copying a host-built binary into the image would shadow the
# one the image builds, with no way to tell which is running.
**/*.o
**/*.a
**/*.so
**/*.so.*
**/ns-example
**/ns-example-2d
**/ns-example-3d
**/ns-complex-3d
**/ns-exemple-3d
**/generate_amr
higflow/src.zip
higtree/include/
higflow/include/
higtree/lib/
higflow/lib/
build/
install/

# Simulation output
**/VTKS/
**/DATA/
**/output/
**/*.vtk

# The host-side scratch directory mounted at /work. It is where results land,
# so it grows; nothing in it belongs in the image.
cases/

# Documentation and figures — not needed to compile
Manual_Euler/
Manual_Git/
docs/images/
**/doc/figuras/
**/*.pdf

# Editor and OS noise
.vscode/
.idea/
**/*.swp
**/__pycache__/
.DS_Store
