# ─────────────────────────────────────────────────────────────────────────────
# Build output
# ─────────────────────────────────────────────────────────────────────────────
# Anchored to the repository root and matched as directories. The previous
# patterns were `**build**` and `**install**`, which match any path containing
# those substrings anywhere — including higtree/src/build-fringe.cpp, which is
# a compiled source file, and any documentation placed under docs/install/.
/build/
/build-*/
/cmake-build-*/
# CMakeLists.txt sets INSTALL_PATH to <source>/install when no prefix is given,
# so the root install/ directory is build output. Installation *scripts* belong
# somewhere else — scripts/install/ — or they land here and vanish.
/install/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# Generated by the Makefile from src/*.h — see higtree/Makefile and
# higflow/Makefile. Not sources.
/higtree/include/
/higflow/include/
/higtree/lib/
/higflow/lib/

# Object files, libraries, executables
*.o
*.ko
*.obj
*.elf
*.lo
*.la
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.gch
*.pch
*.d

# Linker and debug output
*.ilk
*.map
*.exp
*.pdb
*.idb
*.su
*.dSYM/

# Solver binaries built from the example drivers
higflow/example*/ns-example
higflow/example*/ns-example-2d
higflow/example*/ns-example-3d
higflow/example*/ns-complex-3d
higflow/example*/amrs/generate_amr

# Coverage
*.gcda
*.gcno
*.gcov

# ─────────────────────────────────────────────────────────────────────────────
# Simulation output
# ─────────────────────────────────────────────────────────────────────────────
# Scoped to the directories the examples write into, rather than ignoring
# *.vtk, *.dat and *.txt everywhere. The global patterns hid legitimate files
# and forced a `!CMakeLists.txt` exception to undo part of the damage.
VTKS/
DATA/
output/
higflow/example*/*.save*
higflow/example*/*.print*
higflow/example*/matrix

# ─────────────────────────────────────────────────────────────────────────────
# Third-party archives
# ─────────────────────────────────────────────────────────────────────────────
# The directory itself is tracked: it holds fetch-petsc.sh. Only the downloaded
# and extracted contents are ignored.
bibliotecas/*.tar.gz
bibliotecas/*.tar.bz2
bibliotecas/*.part
bibliotecas/*.bad
bibliotecas/petsc-*/
bibliotecas/libfyaml-master/

# Container images
*.sif
*.simg

# ─────────────────────────────────────────────────────────────────────────────
# LaTeX intermediates
# ─────────────────────────────────────────────────────────────────────────────
*.aux
*.log
*.toc
*.lof
*.lot
*.out
*.synctex.gz
*.fdb_latexmk
*.fls

# ─────────────────────────────────────────────────────────────────────────────
# Editors and tooling
# ─────────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.cache/
.clangd/
