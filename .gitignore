# .gitignore — organizado por categoria
# Padroes preexistentes foram preservados; excecoes (!) ficam no fim,
# onde o gitignore garante que prevalecem.

# Ferramentas de IA — nunca versionar
.claude/
.cline/
.codex/
.cursor/
.worktrees/
AGENTS.md
CLAUDE.local.md
CLAUDE.md
GEMINI.md

# Python
*.pyc
/build/
__pycache__/

# Dados, modelos e saidas
DATA/
cases/*
output/

# LaTeX
*.aux
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.synctex.gz
*.toc

# Node e frontend
.cache/

# Compilados e binarios
*.a
*.dll
*.dylib
*.exe
*.lib
*.o
*.obj
*.pdb
*.so
CMakeCache.txt
CMakeFiles/

# Bancos de dados locais
Thumbs.db

# IDEs e editores
*.swo
*.swp
*~
.idea/
.vscode/

# Sistema operacional
.DS_Store

# Logs e temporarios
*.log

# Especifico do projeto
/build-*/
/cmake-build-*/
/install/
cmake_install.cmake
compile_commands.json
/higtree/include/
/higflow/include/
/higtree/lib/
/higflow/lib/
*.ko
*.elf
*.lo
*.la
*.so.*
*.gch
*.pch
*.d
*.ilk
*.map
*.exp
*.idb
*.su
*.dSYM/
higflow/example*/ns-example
higflow/example*/ns-example-2d
higflow/example*/ns-example-3d
higflow/example*/ns-complex-3d
higflow/example*/amrs/generate_amr
*.gcda
*.gcno
*.gcov
VTKS/
higflow/example*/*.save*
higflow/example*/*.print*
higflow/example*/matrix
bibliotecas/*.tar.gz
bibliotecas/*.tar.bz2
bibliotecas/*.part
bibliotecas/*.bad
bibliotecas/petsc-*/
bibliotecas/libfyaml-master/
*.sif
*.simg
.clangd/

# Excecoes — mantidas por ultimo: no gitignore o ultimo padrao que casa vence
!cases/.gitkeep
