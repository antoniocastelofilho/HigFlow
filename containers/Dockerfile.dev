# HigFlow — development image
#
#     docker build -f containers/Dockerfile.dev -t higflow:dev .
#
# Differs from containers/Dockerfile in two ways that matter.
#
# It adds the tools you need when something is wrong rather than when
# everything is right: a debugger, a memory checker, a profiler and a language
# server.
#
# And it does not copy the sources in. The repository is mounted at /src at run
# time, so an edit on the host is immediately visible inside the container and
# `make` rebuilds only what changed. Copying sources into a development image
# means rebuilding the image after every edit, which is the opposite of what a
# development image is for.

FROM higflow:latest AS dev

USER root

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        gdb \
        valgrind \
        strace \
        ltrace \
        linux-tools-generic \
        clangd \
        clang-format \
        clang-tidy \
        cppcheck \
        vim \
        less \
        tree \
        rsync \
        bear \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# bear records a compile_commands.json from a plain `make` run, which is what
# clangd needs to resolve includes. The Makefile build does not produce one;
# the CMake build does.
#
#     bear -- make DIM=2

USER higflow
WORKDIR /src

CMD ["bash"]
